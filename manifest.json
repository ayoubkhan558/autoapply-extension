{
  "manifest_version": 3,
  "name": "AutoApply — Form Autofiller",
  "version": "1.25.2",
  "description": "Autofill forms and job applications from a local JSON profile.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.x.ai/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/fields.js",
        "lib/matcher.js",
        "lib/storage.js",
        "content/dom/dates.js",
        "content/dom/phone.js",
        "content/dom/currency.js",
        "content/dom/appliers.js",
        "content/dom/profile.js",
        "content/dom/labels.js",
        "content/dom/native-values.js",
        "content/dom/matching.js",
        "content/dom/controls.js",
        "content/eligibility/policy.js",
        "content/eligibility/roots.js",
        "content/eligibility/index.js",
        "content/safety.js",
        "content/fill/context.js",
        "content/fill/text-checkboxes.js",
        "content/fill/radios.js",
        "content/fill/uploads.js",
        "content/fill/widgets.js",
        "content/fill/repeaters.js",
        "content/fill.js",
        "content/ui/panel.js",
        "content/ui/analysis.js",
        "content/ui/application.js",
        "content/ui/questions.js",
        "content/ui/attention.js",
        "content/ui/results.js",
        "content/ui/lasso.js",
        "content/detect.js",
        "content/field-ai.js",
        "content/job-search/query.js",
        "content/job-search/modal.js",
        "content/job-search/boot.js",
        "content.js"
      ],
      "css": [
        "content/styles/panel.css",
        "content/styles/results.css",
        "content/styles/detection.css",
        "content/styles/field-ai.css",
        "content/styles/overrides.css",
        "content/styles/job-search.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/profile.default.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Autofill the current page"
    }
  }
}
